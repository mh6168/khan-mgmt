APP_ENV=development
APP_DEBUG=true
APP_NAME=KHAN Management

# Firebase Authentication and Firestore
FIREBASE_WEB_API_KEY=replace-with-firebase-web-api-key
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
FIREBASE_AUTH_TIMEOUT_SECONDS=10
FIREBASE_ADMIN_SERVICE_ACCOUNT_FILE=storage/firebase-service-account.json

# Admin authentication (server-side only). Generate a hash with password_hash().
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD_HASH=replace-with-password-hash

# Supabase Storage only. Never expose this key in browser code.
SUPABASE_URL=https://replace-with-project-ref.supabase.co
SUPABASE_STORAGE_BUCKET=jeweler-documents
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
SUPABASE_TIMEOUT_SECONDS=10

# Paymob test checkout
PAYMOB_API_KEY=replace-with-paymob-test-api-key
PAYMOB_INTEGRATION_ID=replace-with-paymob-test-card-integration-id
PAYMOB_IFRAME_ID=replace-with-paymob-test-iframe-id
PAYMOB_API_BASE_URL=https://accept.paymob.com/api
PAYMOB_TIMEOUT_SECONDS=10
PAYMOB_REDIRECT_URL=https://your-public-host/jeweler/payment-success.php
